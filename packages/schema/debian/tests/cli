#!/bin/sh
# autopkgtest: the installed compiler reports its version, then checks and
# generates C++ from the README example schema. `schema check` is silent on
# success and signals through its exit code; generation must produce
# non-empty headers. Also run by scripts/smoke-test.sh against the freshly
# installed .deb, with AUTOPKGTEST_TMP pointed at a temp directory.
set -e
cd "$AUTOPKGTEST_TMP"

schema version

mkdir -p example
cat > example/example.schema <<'SRC'
package example

const MaxHealth = 1000

enum ShipType { Fighter, Corvette, Bomber }

flags ShipFlags { Firing, Thrusting, Disabled }

type Vec3
{
    x float64
    y float64
    z float64
}

type Quaternion
{
    x float64
    y float64
    z float64
    w float64 = 1.0
}

type ShipState
{
    ship_type  ShipType
    ship_flags ShipFlags
    position   Vec3
    rotation   Quaternion
    health     int32 | min = 0, max = MaxHealth
    at_rest    bool
    if !at_rest
    {
        linear_velocity  Vec3
        angular_velocity Vec3
    }
}
SRC

schema check example
schema id example

schema generate --lang cpp --out generated example
test -s generated/example.h
test -s generated/exampleWire.h

echo OK
